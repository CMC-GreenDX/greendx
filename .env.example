# Copy this file to .env and adjust it locally. Never commit .env.
# Only placeholder values belong here. Real secrets are stored in OpenBao (later in Phase 1).
# `make up` creates .env from this file when it is missing.

COMPOSE_PROJECT_NAME=ecotrace
# Profiles: core (Tier 1 only), app (core + capabilities + apps), full (adds heavy optional services)
COMPOSE_PROFILES=core

# PostgreSQL superuser and the Keycloak database owner
POSTGRES_PASSWORD=change-me-postgres
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Service database roles (row-level security applies to them)
INTAKE_DB_PASSWORD=change-me-intake-db
LEDGER_DB_PASSWORD=change-me-ledger-db
TRILLIAN_DB_PASSWORD=change-me-trillian-db
PURCHASE_DB_PASSWORD=change-me-purchase-db
FLOWABLE_DB_PASSWORD=change-me-flowable-db

# Flowable REST administrator (used by the workflow capability and dxctl)
FLOWABLE_ADMIN_PASSWORD=change-me-flowable-admin

# Address users type in the browser. Keycloak issues tokens for it and every service checks it.
# In a codespace with a public port, use the output of `make public-url`.
PUBLIC_URL=http://localhost:9080

# Keycloak bootstrap administrator (user name: admin)
KC_ADMIN_PASSWORD=change-me-keycloak-admin

# Hasura admin secret (console and metadata API)
HASURA_ADMIN_SECRET=change-me-hasura-admin

# S3 credentials of the SeaweedFS object store
S3_ACCESS_KEY=ecotrace
S3_SECRET_KEY=change-me-s3-secret

# Password of the demo users (alice, bob) in the demo realm
DEMO_USER_PASSWORD=change-me-demo
