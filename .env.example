# Copy this file to .env and adjust it locally. Never commit .env.
# Only placeholder values belong here. Real secrets are stored in OpenBao.
# Service variables are added in Phase 1 together with the Compose profiles.

COMPOSE_PROJECT_NAME=ecotrace
# Profiles: core (Tier 1 only), app (core + capabilities + apps), full (adds heavy optional services)
COMPOSE_PROFILES=core
