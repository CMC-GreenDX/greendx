<?xml version="1.0" encoding="UTF-8"?>
<!-- Company C: one step. The production manager approves activity data before it becomes an emission entry. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://ecotrace.example/workflows/company-c-cement">
  <process id="verify-activity" name="Verify activity data (Company C)" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toApprove" sourceRef="start" targetRef="headApproves"/>
    <userTask id="headApproves" name="Quản đốc sản xuất phê duyệt số liệu" flowable:candidateGroups="approver"/>
    <sequenceFlow id="toEnd" sourceRef="headApproves" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
