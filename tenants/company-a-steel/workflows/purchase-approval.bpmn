<?xml version="1.0" encoding="UTF-8"?>
<!-- Company A: purchase invoices are approved by an approver before payment. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://ecotrace.example/workflows/company-a-steel">
  <process id="purchase-approval" name="Purchase approval (Company A)" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toApprove" sourceRef="start" targetRef="approvePurchase"/>
    <userTask id="approvePurchase" name="Phê duyệt hoá đơn mua hàng" flowable:candidateGroups="approver"/>
    <sequenceFlow id="toEnd" sourceRef="approvePurchase" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
