<?xml version="1.0" encoding="UTF-8"?>
<!-- Company A: one step. The head of department approves activity data before it becomes an emission entry. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://ecotrace.example/workflows/company-a-steel">
  <process id="verify-activity" name="Verify activity data (Company A)" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toApprove" sourceRef="start" targetRef="headApproves"/>
    <userTask id="headApproves" name="Trưởng bộ phận phê duyệt số liệu hoạt động" flowable:candidateGroups="approver"/>
    <sequenceFlow id="toEnd" sourceRef="headApproves" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
