{
  // Development environment for GitHub Codespaces and VS Code Dev Containers.
  // The core needs about 16 GB RAM, so Codespaces picks the 4-core / 16 GB machine.
  "name": "EcoTrace",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.9-ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    // Lets `gh codespace ssh` run the stack and the demo from a terminal.
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8080, 8081, 9080],
  "portsAttributes": {
    "8080": { "label": "Keycloak" },
    "8081": { "label": "Hasura console" },
    "9080": { "label": "API gateway (APISIX)" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends jq make && cp -n .env.example .env"
}
